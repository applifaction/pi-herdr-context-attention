{
  "name": "pi-herdr-context-attention",
  "version": "0.3.0",
  "description": "Show a dedicated Context full warning in Herdr when a Pi agent needs compaction, without changing native agent states.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "herdr", "context-window", "compaction"],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:tui": "uv run --with pyte python tests/tui_smoke.py"
  },
  "files": ["index.ts", "metadata.ts", "compaction-observer.ts", "README.md", "tests/"],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true }
  },
  "pi": {
    "extensions": ["./index.ts"]
  }
}
